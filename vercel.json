{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/products",
      "destination": "/api/data"
    },
    {
      "source": "/api/catalog",
      "destination": "/api/data"
    },
    {
      "source": "/api/custom-email",
      "destination": "/api/orders?resource=check-email"
    },
    {
      "source": "/api/notifications",
      "destination": "/api/topup?resource=notifications"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/admin/:path*",
      "destination": "/"
    },
    {
      "source": "/account",
      "destination": "/"
    },
    {
      "source": "/topup",
      "destination": "/"
    },
    {
      "source": "/orders",
      "destination": "/"
    },
    {
      "source": "/help",
      "destination": "/"
    },
    {
      "source": "/terms",
      "destination": "/"
    },
    {
      "source": "/privacy",
      "destination": "/"
    },
    {
      "source": "/refund",
      "destination": "/"
    },
    {
      "source": "/disclaimer",
      "destination": "/"
    }
  ]
}
