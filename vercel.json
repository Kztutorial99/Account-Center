{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/notifications",
      "destination": "/api/topup?resource=notifications"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/admin/:path*",
      "destination": "/"
    },
    {
      "source": "/account",
      "destination": "/"
    },
    {
      "source": "/topup",
      "destination": "/"
    },
    {
      "source": "/orders",
      "destination": "/"
    },
    {
      "source": "/help",
      "destination": "/"
    }
  ]
}