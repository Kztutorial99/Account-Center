{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/orders.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/products",
      "destination": "/api/data"
    },
    {
      "source": "/api/catalog",
      "destination": "/api/data"
    },
    {
      "source": "/api/custom-email",
      "destination": "/api/orders?resource=check-email"
    },
    {
      "source": "/api/notifications",
      "destination": "/api/topup?resource=notifications"
    },
    {
      "source": "/custom-email",
      "destination": "/"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/admin/:path*",
      "destination": "/"
    },
    {
      "source": "/account",
      "destination": "/"
    },
    {
      "source": "/topup",
      "destination": "/"
    },
    {
      "source": "/orders",
      "destination": "/"
    },
    {
      "source": "/help",
      "destination": "/"
    },
    {
      "source": "/terms",
      "destination": "/"
    },
    {
      "source": "/privacy",
      "destination": "/"
    },
    {
      "source": "/refund",
      "destination": "/"
    },
    {
      "source": "/disclaimer",
      "destination": "/"
    },
    {
      "source": "/katalog",
      "destination": "/"
    },
    {
      "source": "/((?!api/|assets/)[^.]*)",
      "destination": "/"
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    }
  ]
}
